# Copy to .env.prod and fill in values:
#   cp .env.prod.example .env.prod

# --- Database (used by docker-compose postgres service) ---
POSTGRES_USER=study
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=study_assistant

# API 连接串（Compose 必填）。容器内主机名固定为 postgres。
# 若密码包含 @ : / # ? & 等字符，必须做 URL 编码后再填，
# 例如密码 p@ss:word 要写成 p%40ss%3Aword。
DATABASE_URL=postgresql://study:change_me_strong_password@postgres:5432/study_assistant?schema=public

# --- HTTP ---
HTTP_PORT=80

# --- API (server reads these via env_file) ---
# Required: random string of at least 32 characters. Startup fails when empty.
JWT_SECRET=
# Optional: separate secret for refresh tokens. Falls back to JWT_SECRET.
# JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# LLM — 阿里云百炼示例
OPENAI_API_KEY=sk-your-bailian-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# ASR — 讯飞（可选，不配则口语识别不可用）
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=

# --- Billing / WeChat Pay (web) ---
# 网页版微信支付：PC 使用 Native 扫码，手机浏览器使用 H5 跳转。
# 证书目录不要提交到 git；Docker 部署时把证书挂载到容器内对应路径。
PAYMENT_PROVIDER=wechat
# ALLOW_MOCK_PAYMENT 保持关闭；仅本地演示才可临时启用
WECHAT_PAY_MCHID=
WECHAT_PAY_APPID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MCH_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=/app/certs/apiclient_key.pem
WECHAT_PAY_NOTIFY_URL=https://your-domain/api/billing/wechat/notify
WECHAT_PAY_PLATFORM_CERTS_PATH=/app/certs/platform-certs.json
WECHAT_PAY_H5_APP_NAME=学习助手
WECHAT_PAY_H5_APP_URL=https://your-domain
WECHAT_PAY_H5_REDIRECT_URL=https://your-domain/#/pages/membership/membership

# Admin account (created/updated on first API start)
ADMIN_USERNAME=admin
# Required in production. Run `cd server && npm run seed:admin` to reset explicitly.
ADMIN_PASSWORD=

SPEECH_PASS_THRESHOLD=70
TTS_VOICE=en-US-JennyNeural
