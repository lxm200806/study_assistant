{
    "version": "1.0.0",
    "name": "study-assistant",
    "description": "Study Assistant - a language learning app",
    "scripts": {
        "dev:h5": "node scripts/dev.mjs start web --foreground",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint \"src/**/*.{ts,vue}\"",
        "lint:server": "eslint --config server/.eslintrc.cjs --resolve-plugins-relative-to . \"server/src/**/*.ts\" --max-warnings 0",
        "test": "npm --prefix server run test",
        "test:db": "npm --prefix server run test:db",
        "test:frontend": "vitest run",
        "test:frontend:watch": "vitest",
        "test:e2e": "playwright test",
        "gen:api": "npm --prefix server run openapi:export && openapi-typescript server/openapi.json -o src/types/api-generated.ts",
        "build:mp-weixin": "node scripts/run-uni.mjs build -p mp-weixin",
        "dev:app": "node scripts/run-uni.mjs -p app",
        "build:app": "node scripts/run-uni.mjs build -p app",
        "build:h5": "node scripts/run-uni.mjs build",
        "fix:native": "bash scripts/fix-native-deps.sh",
        "dev:mp-weixin": "node scripts/run-uni.mjs -p mp-weixin"
    },
    "dependencies": {
        "@dcloudio/uni-app": "3.0.0-4020420240722001",
        "@dcloudio/uni-components": "3.0.0-4020420240722001",
        "@dcloudio/uni-h5": "3.0.0-4020420240722001",
        "@dcloudio/uni-mp-weixin": "3.0.0-4020420240722001",
        "pinia": "^2.1.7",
        "vue": "^3.4.21"
    },
    "devDependencies": {
        "@dcloudio/types": "^3.4.8",
        "@dcloudio/uni-app-plus": "^3.0.0-4020420240722001",
        "@dcloudio/uni-cli-shared": "3.0.0-4020420240722001",
        "@dcloudio/uni-stacktracey": "3.0.0-4020420240722001",
        "@dcloudio/vite-plugin-uni": "3.0.0-4020420240722001",
        "@playwright/test": "^1.65.1",
        "@types/node": "^20.11.0",
        "@typescript-eslint/eslint-plugin": "^8.73.0",
        "@typescript-eslint/parser": "^7.18.0",
        "@vitejs/plugin-vue": "^5.2.4",
        "@vue/test-utils": "^2.6.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^9.1.2",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-vue": "^9.32.0",
        "happy-dom": "^15.11.7",
        "openapi-typescript": "^7.13.0",
        "prettier": "^3.8.4",
        "sass": "^1.100.0",
        "sass-embedded": "^1.100.0",
        "typescript": "^5.3.3",
        "vite": "^5.0.12",
        "vitest": "^3.2.7",
        "vue-tsc": "^2.2.0"
    }
}
