{
  "name": "study-assistant-server",
  "version": "1.0.0",
  "description": "学习助手服务端",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node ../scripts/dev.mjs start api --foreground --no-db --no-migrate",
    "db:migrate": "node ../scripts/dev.mjs migrate",
    "db:studio": "node ./node_modules/prisma/build/index.js studio",
    "build": "node ./node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "prisma:init": "node ./node_modules/prisma/build/index.js init",
    "prisma:migrate": "node ./node_modules/prisma/build/index.js migrate dev",
    "build:vocabulary": "node ./node_modules/ts-node/dist/bin.js scripts/vocabulary-import/build-all.ts --api",
    "build:vocabulary:fast": "node ./node_modules/ts-node/dist/bin.js scripts/vocabulary-import/build-all.ts",
    "build:mse": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-mse.ts --api",
    "build:mse:fast": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-mse.ts",
    "polish:mse": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/polish-mse.ts",
    "polish:zhongkao": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/polish-zhongkao.ts",
    "build:cnexam-gloss": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-cnexam-glosses.ts",
    "build:senses": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-senses.ts",
    "build:kew": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-kew.ts --api",
    "build:kew:fast": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-kew.ts",
    "build:kew1200": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-kew.ts kew1200 --api",
    "build:kew1200:fast": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-kew.ts kew1200",
    "build:kew4500": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-kew.ts kew4500 --api",
    "build:kew4500:fast": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-kew.ts kew4500",
    "build:kew7200": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-kew.ts kew7200 --api",
    "build:kew7200:fast": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-kew.ts kew7200",
    "cishu:bianpai": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/arrange-books.ts",
    "paoguang:kew1200": "npm run cishu:bianpai -- kew1200",
    "paoguang:kew4500": "npm run cishu:bianpai -- kew4500",
    "paoguang:kew7200": "npm run cishu:bianpai -- kew7200",
    "cidian:daoru-ciguang": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/import-atlas-to-lexicon.ts",
    "cidian:quezi": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/seed-lexicon-missing.ts",
    "cidian:jiaoyan": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/verify-lexicon.ts",
    "cidian:tianchong": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/enrich-from-atlas.ts",
    "cidian:yasuo": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/migrate-senses-nested.ts",
    "cishu:daochu": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/export-book-lexicon-delta.ts",
    "cishu:shoushen": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/slim-book.ts",
    "cidian:hebing": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/merge-lexicon-from-books.ts",
    "tongbu:cishu": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/sync-books.ts",
    "polish:kew1200": "npm run cishu:bianpai -- kew1200",
    "polish:kew4500": "npm run cishu:bianpai -- kew4500",
    "polish:kew7200": "npm run cishu:bianpai -- kew7200",
    "arrange:books": "npm run cishu:bianpai --",
    "enrich:atlas": "npm run cidian:tianchong --",
    "lexicon:import-atlas": "npm run cidian:daoru-ciguang --",
    "lexicon:seed-missing": "npm run cidian:quezi --",
    "lexicon:verify": "npm run cidian:jiaoyan --",
    "lexicon:compress": "npm run cidian:yasuo --",
    "lexicon:export-books": "npm run cishu:daochu --",
    "lexicon:merge-books": "npm run cidian:hebing --",
    "lexicon:slim-books": "npm run cishu:shoushen --",
    "sync:books": "npm run tongbu:cishu --",
    "kb:sync": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/kb/sync-md.ts",
    "kb:extract": "python3 scripts/kb/extract_textbook_md.py",
    "kb:import": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/kb/import-md.ts",
    "kb:rebuild": "npm run kb:extract && npm run kb:import",
    "fill:mse": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/fill-mse-from-shared.ts",
    "build:cet-books": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-cet-books.ts",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "openapi:export": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/export-openapi.ts",
    "content:sync": "node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/sync-content.ts",
    "migrate:fsrs": "node ./node_modules/ts-node/dist/bin.js scripts/migrate-fsrs.ts",
    "seed:admin": "node ./node_modules/ts-node/dist/bin.js scripts/seed-admin.ts",
    "fill:meanings": "node ./node_modules/ts-node/dist/bin.js scripts/fill-missing-meanings.ts",
    "build:idioms": "node scripts/idiom-rebuild/build-pack.js",
    "audit:idioms": "node scripts/idiom-rebuild/audit-cards.js",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:db": "node ./scripts/run-db-tests.mjs",
    "test:watch": "node ./node_modules/vitest/vitest.mjs"
  },
  "keywords": [
    "learning",
    "vocabulary",
    "AI"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@prisma/client": "^5.10.0",
    "@sentry/node": "^8.55.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "edge-tts-universal": "^1.4.0",
    "express": "^4.18.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.0",
    "prisma": "^5.10.0",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.0",
    "ts-fsrs": "^5.4.1",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.0.2",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  }
}
