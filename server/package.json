{
  "name": "study-assistant-server",
  "version": "1.0.0",
  "description": "学习助手服务端",
  "main": "dist/app.js",
  "scripts": {
    "dev": "bash dev.sh",
    "db:migrate": "bash ../scripts/db-migrate.sh",
    "db:studio": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/prisma/build/index.js studio'",
    "build": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/typescript/bin/tsc'",
    "start": "bash -c 'source ../scripts/node-env.sh && node dist/app.js'",
    "prisma:init": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/prisma/build/index.js init'",
    "prisma:migrate": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/prisma/build/index.js migrate dev'",
    "build:vocabulary": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js scripts/vocabulary-import/build-all.ts --api'",
    "build:vocabulary:fast": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js scripts/vocabulary-import/build-all.ts'",
    "build:mse": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-mse.ts --api'",
    "build:mse:fast": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-mse.ts'",
    "polish:mse": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/polish-mse.ts'",
    "polish:zhongkao": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/polish-zhongkao.ts'",
    "build:cnexam-gloss": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-cnexam-glosses.ts'",
    "build:senses": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-senses.ts'",
    "build:kew": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-kew.ts --api'",
    "build:kew:fast": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-kew.ts'",
    "build:kew1200": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-kew.ts kew1200 --api'",
    "build:kew1200:fast": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-kew.ts kew1200'",
    "build:kew4500": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-kew.ts kew4500 --api'",
    "build:kew4500:fast": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-kew.ts kew4500'",
    "build:kew7200": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-kew.ts kew7200 --api'",
    "build:kew7200:fast": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-kew.ts kew7200'",
    "paoguang:kew1200": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/polish-kew.ts kew1200'",
    "paoguang:kew4500": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/polish-kew.ts kew4500'",
    "paoguang:kew7200": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/polish-kew.ts kew7200'",
    "cidian:daoru-ciguang": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/import-atlas-to-lexicon.ts \"$@\"' --",
    "cidian:quezi": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/seed-lexicon-missing.ts \"$@\"' --",
    "cidian:jiaoyan": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/verify-lexicon.ts \"$@\"' --",
    "cidian:tianchong": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/enrich-from-atlas.ts \"$@\"' --",
    "cidian:yasuo": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/migrate-senses-nested.ts \"$@\"' --",
    "tongbu:cishu": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/sync-books.ts \"$@\"' --",
    "polish:kew1200": "npm run paoguang:kew1200",
    "polish:kew4500": "npm run paoguang:kew4500",
    "polish:kew7200": "npm run paoguang:kew7200",
    "enrich:atlas": "npm run cidian:tianchong --",
    "lexicon:import-atlas": "npm run cidian:daoru-ciguang --",
    "lexicon:seed-missing": "npm run cidian:quezi --",
    "lexicon:verify": "npm run cidian:jiaoyan --",
    "lexicon:compress": "npm run cidian:yasuo --",
    "sync:books": "npm run tongbu:cishu --",
    "fill:mse": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/fill-mse-from-shared.ts'",
    "build:cet-books": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js --transpile-only scripts/vocabulary-import/build-cet-books.ts'",
    "prisma:generate": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/prisma/build/index.js generate'",
    "migrate:fsrs": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js scripts/migrate-fsrs.ts'",
    "seed:admin": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js scripts/seed-admin.ts'",
    "fill:meanings": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/ts-node/dist/bin.js scripts/fill-missing-meanings.ts'",
    "build:idioms": "node scripts/idiom-rebuild/build-pack.js",
    "audit:idioms": "node scripts/idiom-rebuild/audit-cards.js",
    "test": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/vitest/vitest.mjs run'",
    "test:watch": "bash -c 'source ../scripts/node-env.sh && node ./node_modules/vitest/vitest.mjs'"
  },
  "keywords": [
    "learning",
    "vocabulary",
    "AI"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "edge-tts-universal": "^1.4.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "prisma": "^5.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "ts-fsrs": "^5.4.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.11.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  }
}
