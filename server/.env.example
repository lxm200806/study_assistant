# PostgreSQL（配合项目根目录 docker-compose.yml）
DATABASE_URL="postgresql://study:study123@localhost:5432/study_assistant?schema=public"
# 数据库集成测试（npm run test:db）默认复用上面的 DATABASE_URL，并创建临时 schema。
# 如需独立测试库，取消注释并配置：
# TEST_DATABASE_URL="postgresql://study:study123@localhost:5432/study_assistant_test?schema=public"

# 至少 32 位随机字符串，禁止使用此示例值；缺失时服务拒绝启动
JWT_SECRET=
# 可选：refresh token 独立密钥；未设置时回退到 JWT_SECRET
# JWT_REFRESH_SECRET="replace_with_another_random_secret_at_least_32_chars"
JWT_ACCESS_EXPIRES_IN="2h"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3005
# 生产环境允许跨域的前端来源，逗号分隔；留空时生产只允许同源
# CORS_ORIGINS=https://study.example.com
# 可选：保护 /metrics；设置后需 Bearer 或 ?token=
# METRICS_TOKEN=
# 可选：Sentry/APM；设置 DSN 后上报 5xx
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# 管理员账号：生产环境必须显式设置强密码；本地未设置则跳过创建
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# 仅本地调试用：开启后 /api/auth/wechat 接受任意 code（不调用微信接口），生产永远禁用
# WECHAT_LOGIN_STUB=true

# 阿里云百炼（OpenAI 兼容，Key 不要加引号和分号；保存后 nodemon 会自动重启后端）
# OPENAI_API_KEY=sk-你的百炼Key
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# Whisper 语音转写（可与 OPENAI_API_KEY 共用）
# WHISPER_API_KEY=
# WHISPER_BASE_URL=https://api.openai.com/v1
# WHISPER_MODEL=whisper-1
# SPEECH_PASS_THRESHOLD=70

# DeepSeek 陪聊（国内推荐）
# DEEPSEEK_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 讯飞流式 ASR（国内语音对话推荐，配置后优先于 Whisper）
# XFYUN_APP_ID=
# XFYUN_API_KEY=
# XFYUN_API_SECRET=
