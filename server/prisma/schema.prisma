generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 能登录的家庭账号。用户数、付费、日活、留存都统计这张表。
model User {
  id              String    @id @default(uuid())
  username        String    @unique
  passwordHash    String
  isAdmin         Boolean   @default(false)
  plan            String    @default("free")
  planExpiresAt   DateTime?
  wxOpenId        String?   @unique
  hasOnboarded    Boolean   @default(false)
  activeSubject   String    @default("english")
  displayName     String?
  activeLearnerId String?   @unique
  activeRole      String    @default("parent")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  activeLearner Learner?            @relation("ActiveLearner", fields: [activeLearnerId], references: [id], onDelete: SetNull)
  learners      Learner[]           @relation("AccountLearners")
  bookUnlocks   UserBookUnlock[]
  dailyActives  AccountDailyActive[]
  chineseUploads ChineseResource[]  @relation("ChineseResourceUploader")
  chineseCards  ChinesePublished[]  @relation("ChineseCardCreator")
}

// 学习者（孩子）。学习进度、课程、掌握度都挂在这里；一个账号下多个孩子仍在本表。
model Learner {
  id            String    @id @default(uuid())
  accountId     String
  name          String
  activeSubject String    @default("english")
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  account             User                  @relation("AccountLearners", fields: [accountId], references: [id], onDelete: Cascade)
  selectedBy          User?                 @relation("ActiveLearner")
  vocabularyStats     VocabularyStat[]
  trainingRecords     TrainingRecord[]
  chatRecords         ChatRecord[]
  speechUsageLogs     SpeechUsageLog[]
  bookStudyProgress   BookStudyProgress[]
  dailyStudyLogs      DailyStudyLog[]
  chineseCourses      ChineseCourse[]
  chineseReviewStates ChineseReviewState[]
  chineseReviewLogs   ChineseReviewLog[]

  @@index([accountId])
}

model AccountDailyActive {
  userId     String
  date       String
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@map("account_daily_actives")
}

model Book {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  level       String
  wordCount   Int      @default(0)
  isFree      Boolean  @default(false)
  createdAt   DateTime @default(now())

  vocabulary    BookVocabulary[]
  studyProgress BookStudyProgress[]
  unlocks       UserBookUnlock[]
}

model BookVocabulary {
  id        String @id @default(uuid())
  bookId    String
  wordId    String
  sortOrder Int    @default(0) @map("sort_order")

  book Book       @relation(fields: [bookId], references: [id])
  word Vocabulary @relation(fields: [wordId], references: [id])

  @@unique([bookId, wordId])
}

model Vocabulary {
  id              String   @id @default(uuid())
  word            String
  meaning         String
  phonetic        String?
  imageUrl        String?
  exampleSentence String?
  englishMeaning  String?
  contentType     String?
  topic           String?
  tags            String[] @default([])
  createdAt       DateTime @default(now())

  vocabularyStats VocabularyStat[]
  trainingRecords TrainingRecord[]
  bookVocabulary  BookVocabulary[]
}

model BookStudyProgress {
  id               String   @id @default(uuid())
  learnerId        String
  bookId           String
  cycleStartedAt   DateTime @default(now())
  practicedWordIds String[] @default([])

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  book    Book    @relation(fields: [bookId], references: [id])

  @@unique([learnerId, bookId])
}

// FSRS 状态；practiceCount/correctCount/mastery 是随练习更新的展示缓存，流水以 TrainingRecord 为准。
model VocabularyStat {
  id             String    @id @default(uuid())
  learnerId      String
  wordId         String
  type           String
  practiceCount  Int       @default(0)
  correctCount   Int       @default(0)
  lastPractice   DateTime?
  mastery        Int       @default(0)
  due            DateTime?
  stability      Float     @default(0)
  difficulty     Float     @default(0)
  reps           Int       @default(0)
  lapses         Int       @default(0)
  fsrsState      String    @default("New")
  lastReview     DateTime?
  retrievability Float     @default(0)
  recentLapse    Boolean   @default(false)

  learner Learner    @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  word    Vocabulary @relation(fields: [wordId], references: [id])

  @@unique([learnerId, wordId, type])
  @@index([learnerId, type, due])
}

model TrainingRecord {
  id        String   @id @default(uuid())
  learnerId String
  wordId    String
  type      String
  isCorrect Boolean
  createdAt DateTime @default(now())

  learner Learner    @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  word    Vocabulary @relation(fields: [wordId], references: [id])
}

model ChatRecord {
  id        String   @id @default(uuid())
  learnerId String
  role      String
  content   String
  mode      String?
  createdAt DateTime @default(now())

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
}

model SpeechUsageLog {
  id        String   @id @default(uuid())
  learnerId String
  kind      String
  createdAt DateTime @default(now())

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId, createdAt])
}

model DailyStudyLog {
  id        String   @id @default(uuid())
  learnerId String
  date      String
  wordCount Int      @default(0)
  streak    Int      @default(0)
  createdAt DateTime @default(now())

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([learnerId, date])
  @@index([learnerId, date])
}

model UserBookUnlock {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id])

  @@unique([userId, bookId])
}

model ChineseResource {
  id            String   @id @default(uuid())
  ownerType     String
  ownerId       String?
  path          String
  filename      String
  mime          String?
  slug          String   @default("")
  status        String   @default("stored")
  uploadedBy    String?
  syncedVersion Int      @default(0)
  syncedHash    String   @default("")
  createdAt     DateTime @default(now())

  uploader  User?              @relation("ChineseResourceUploader", fields: [uploadedBy], references: [id])
  published ChinesePublished[]

  @@index([ownerType, slug])
  @@map("chinese_resources")
}

model ChinesePublished {
  id               String    @id @default(uuid())
  kind             String
  level            String
  grade            String    @default("")
  prompt           String
  answer           String
  tags             String    @default("")
  source           String    @default("")
  sourceResourceId String?
  draftId          String?
  pointKey         String?   @unique
  groupKey         String    @default("")
  subGroupKey      String    @default("")
  entryKey         String    @default("")
  lemma            String    @default("")
  questionType     String    @default("dictation")
  audience         String    @default("all")
  difficulty       String    @default("")
  isActive         Boolean   @default(true)
  options          Json      @default("{}")
  status           String    @default("published")
  createdBy        String?
  createdAt        DateTime  @default(now())
  publishedAt      DateTime?

  sourceResource ChineseResource?     @relation(fields: [sourceResourceId], references: [id])
  creator        User?                @relation("ChineseCardCreator", fields: [createdBy], references: [id])
  courseItems    ChineseCourseItem[]
  reviewStates   ChineseReviewState[]
  reviewLogs     ChineseReviewLog[]

  @@index([kind, level, grade])
  @@index([entryKey])
  @@index([groupKey])
  @@index([questionType])
  @@index([difficulty])
  @@index([isActive])
  @@index([status])
  @@map("chinese_published")
}

model ChineseEntry {
  id        String   @id @default(uuid())
  entryKey  String   @unique
  kind      String
  lemma     String   @default("")
  tags      String   @default("")
  source    String   @default("")
  updatedAt DateTime @updatedAt

  gradeLinks ChineseEntryGrade[]
  levelLinks ChineseEntryLevel[]

  @@map("chinese_entries")
}

model ChineseEntryGrade {
  entryKey String
  grade    String
  entry    ChineseEntry @relation(fields: [entryKey], references: [entryKey], onDelete: Cascade)

  @@id([entryKey, grade])
  @@index([grade])
  @@map("chinese_entry_grades")
}

model ChineseEntryLevel {
  entryKey String
  level    String
  entry    ChineseEntry @relation(fields: [entryKey], references: [entryKey], onDelete: Cascade)

  @@id([entryKey, level])
  @@map("chinese_entry_levels")
}

model ChineseCourse {
  id                String   @id @default(uuid())
  learnerId         String
  name              String
  note              String   @default("")
  kinds             String   @default("")
  levels            String   @default("")
  grades            String   @default("")
  difficulties      String   @default("")
  dailyMinutes      Int      @default(15)
  reviewDefaultTest Boolean  @default(false)
  createdAt         DateTime @default(now())

  learner      Learner              @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  items        ChineseCourseItem[]
  reviewStates ChineseReviewState[]
  reviewLogs   ChineseReviewLog[]

  @@index([learnerId])
  @@map("chinese_courses")
}

model ChineseCourseItem {
  courseId String
  pointId  String
  sort     Int    @default(0)

  course ChineseCourse    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  point  ChinesePublished @relation(fields: [pointId], references: [id])

  @@id([courseId, pointId])
  @@map("chinese_course_items")
}

model ChineseReviewState {
  learnerId String
  courseId  String
  pointId   String
  n         Int       @default(0)
  ef        Float     @default(2.5)
  interval  Int       @default(0)
  due       DateTime? @db.Date
  lapses    Int       @default(0)
  last      DateTime? @db.Date

  learner Learner          @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  course  ChineseCourse    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  point   ChinesePublished @relation(fields: [pointId], references: [id])

  @@id([learnerId, courseId, pointId])
  @@index([learnerId, courseId, due])
  @@map("chinese_review_states")
}

model ChineseReviewLog {
  id        String   @id @default(uuid())
  learnerId String
  courseId  String
  pointId   String
  quality   Int
  isNew     Boolean
  correct   Boolean
  createdAt DateTime @default(now())

  learner Learner          @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  course  ChineseCourse    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  point   ChinesePublished @relation(fields: [pointId], references: [id])

  @@index([learnerId, courseId, createdAt])
  @@map("chinese_review_logs")
}
