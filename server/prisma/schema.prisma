generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  username      String    @unique
  passwordHash  String
  isAdmin       Boolean   @default(false)
  plan          String    @default("free")
  planExpiresAt DateTime?
  wxOpenId      String?   @unique
  hasOnboarded  Boolean   @default(false)
  activeSubject String    @default("english")
  accountType     String    @default("parent")
  displayName     String?
  parentId        String?
  activeLearnerId String?
  activeRole      String    @default("parent")
  archivedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  parent   User?  @relation("ParentChildren", fields: [parentId], references: [id])
  children User[] @relation("ParentChildren")
  
  vocabularyStats VocabularyStat[]
  trainingRecords TrainingRecord[]
  chatRecords     ChatRecord[]
  speechUsageLogs SpeechUsageLog[]
  bookStudyProgress BookStudyProgress[]
  dailyStudyLogs  DailyStudyLog[]
  bookUnlocks     UserBookUnlock[]
  orgMembers      OrgMember[]
  chineseCourses      ChineseCourse[]
  chineseReviewStates ChineseReviewState[]
  chineseReviewLogs   ChineseReviewLog[]
  chineseDrafts       ChineseDraft[]
  chineseUploads      ChineseResource[] @relation("ChineseResourceUploader")

  @@index([parentId])
}

model Book {
  id          String      @id @default(uuid())
  name        String      @unique
  code        String      @unique
  description String?
  level       String
  wordCount   Int         @default(0)
  isFree      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  
  vocabulary     BookVocabulary[]
  studyProgress  BookStudyProgress[]
  unlocks        UserBookUnlock[]
}

model BookVocabulary {
  id          String      @id @default(uuid())
  bookId      String
  wordId      String
  sortOrder   Int         @default(0) @map("sort_order")
  
  book        Book        @relation(fields: [bookId], references: [id])
  word        Vocabulary  @relation(fields: [wordId], references: [id])
  
  @@unique([bookId, wordId])
}

model Vocabulary {
  id              String          @id @default(uuid())
  word            String
  meaning         String
  phonetic        String?
  imageUrl        String?
  exampleSentence String?
  englishMeaning  String?
  contentType     String?
  topic           String?
  tags            String[]        @default([])
  createdAt       DateTime        @default(now())
  
  vocabularyStats VocabularyStat[]
  trainingRecords TrainingRecord[]
  bookVocabulary  BookVocabulary[]
}

model BookStudyProgress {
  id               String   @id @default(uuid())
  userId           String
  bookId           String
  cycleStartedAt   DateTime @default(now())
  practicedWordIds String[] @default([])

  user User @relation(fields: [userId], references: [id])
  book Book @relation(fields: [bookId], references: [id])

  @@unique([userId, bookId])
}

model VocabularyStat {
  id            String    @id @default(uuid())
  userId        String
  wordId        String
  type          String
  practiceCount Int       @default(0)
  correctCount  Int       @default(0)
  lastPractice  DateTime?
  mastery       Int       @default(0)
  due           DateTime?
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  fsrsState     String    @default("New")
  lastReview    DateTime?
  retrievability Float    @default(0)
  recentLapse   Boolean   @default(false)

  user   User       @relation(fields: [userId], references: [id])
  word   Vocabulary @relation(fields: [wordId], references: [id])

  @@unique([userId, wordId, type])
  @@index([userId, type, due])
}

model TrainingRecord {
  id         String    @id @default(uuid())
  userId     String
  wordId     String
  type       String
  isCorrect  Boolean
  createdAt  DateTime  @default(now())
  
  user   User       @relation(fields: [userId], references: [id])
  word   Vocabulary @relation(fields: [wordId], references: [id])
}

model ChatRecord {
  id         String    @id @default(uuid())
  userId     String
  role       String
  content    String
  mode       String?
  createdAt  DateTime  @default(now())
  
  user   User       @relation(fields: [userId], references: [id])
}

model SpeechUsageLog {
  id        String   @id @default(uuid())
  userId    String
  kind      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model DailyStudyLog {
  id        String   @id @default(uuid())
  userId    String
  date      String
  wordCount Int      @default(0)
  streak    Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([userId, date])
}

model UserBookUnlock {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  book Book @relation(fields: [bookId], references: [id])

  @@unique([userId, bookId])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  members OrgMember[]
  classes OrgClass[]
}

model OrgMember {
  id        String   @id @default(uuid())
  orgId     String
  userId    String
  role      String   @default("student")
  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id])
  user User         @relation(fields: [userId], references: [id])

  @@unique([orgId, userId])
}

model OrgClass {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  bookCode  String?
  dailyGoal Int      @default(20)
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id])
}

model ChineseResource {
  id            String   @id @default(uuid())
  ownerType     String
  ownerId       String?
  path          String
  filename      String
  mime          String?
  slug          String   @default("")
  status        String   @default("stored")
  uploadedBy    String?
  syncedVersion Int      @default(0)
  syncedHash    String   @default("")
  createdAt     DateTime @default(now())

  uploader   User?              @relation("ChineseResourceUploader", fields: [uploadedBy], references: [id])
  published  ChinesePublished[]

  @@index([ownerType, slug])
  @@map("chinese_resources")
}

model ChineseDraft {
  id               String   @id @default(uuid())
  kind             String
  level            String
  grade            String   @default("")
  prompt           String
  answer           String
  tags             String   @default("")
  source           String   @default("")
  sourceResourceId String?
  createdBy        String?
  pointKey         String   @default("")
  groupKey         String   @default("")
  subGroupKey      String   @default("")
  entryKey         String   @default("")
  lemma            String   @default("")
  questionType     String   @default("dictation")
  audience         String   @default("all")
  options          String   @default("")
  status           String   @default("draft")
  createdAt        DateTime @default(now())

  creator User? @relation(fields: [createdBy], references: [id])

  @@index([status, pointKey])
  @@map("chinese_drafts")
}

model ChinesePublished {
  id               String   @id @default(uuid())
  kind             String
  level            String
  grade            String   @default("")
  prompt           String
  answer           String
  tags             String   @default("")
  source           String   @default("")
  sourceResourceId String?
  draftId          String?
  pointKey         String?  @unique
  groupKey         String   @default("")
  subGroupKey      String   @default("")
  entryKey         String   @default("")
  lemma            String   @default("")
  questionType     String   @default("dictation")
  audience         String   @default("all")
  options          String   @default("")
  publishedAt      DateTime @default(now())

  sourceResource ChineseResource?     @relation(fields: [sourceResourceId], references: [id])
  courseItems    ChineseCourseItem[]
  reviewStates   ChineseReviewState[]
  reviewLogs     ChineseReviewLog[]

  @@index([kind, level, grade])
  @@index([entryKey])
  @@index([groupKey])
  @@index([questionType])
  @@map("chinese_published")
}

model ChineseEntry {
  id        String   @id @default(uuid())
  entryKey  String   @unique
  kind      String
  lemma     String   @default("")
  grade     String   @default("")
  grades    String   @default("")
  levels    String   @default("")
  tags      String   @default("")
  source    String   @default("")
  updatedAt DateTime @updatedAt

  gradeLinks ChineseEntryGrade[]
  levelLinks ChineseEntryLevel[]

  @@map("chinese_entries")
}

model ChineseEntryGrade {
  entryKey String
  grade    String
  entry    ChineseEntry @relation(fields: [entryKey], references: [entryKey], onDelete: Cascade)

  @@id([entryKey, grade])
  @@index([grade])
  @@map("chinese_entry_grades")
}

model ChineseEntryLevel {
  entryKey String
  level    String
  entry    ChineseEntry @relation(fields: [entryKey], references: [entryKey], onDelete: Cascade)

  @@id([entryKey, level])
  @@map("chinese_entry_levels")
}

model ChineseCourse {
  id                String   @id @default(uuid())
  userId            String
  name              String
  note              String   @default("")
  kinds             String   @default("")
  levels            String   @default("")
  grades            String   @default("")
  newEnergy         Int      @default(30)
  reviewEnergy      Int      @default(30)
  reviewDefaultTest Boolean  @default(false)
  createdAt         DateTime @default(now())

  user         User                 @relation(fields: [userId], references: [id])
  items        ChineseCourseItem[]
  reviewStates ChineseReviewState[]
  reviewLogs   ChineseReviewLog[]

  @@index([userId])
  @@map("chinese_courses")
}

model ChineseCourseItem {
  courseId String
  pointId  String
  sort     Int    @default(0)

  course ChineseCourse    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  point  ChinesePublished @relation(fields: [pointId], references: [id])

  @@id([courseId, pointId])
  @@map("chinese_course_items")
}

model ChineseReviewState {
  userId   String
  courseId String
  pointId  String
  n        Int       @default(0)
  ef       Float     @default(2.5)
  interval Int       @default(0)
  due      DateTime? @db.Date
  lapses   Int       @default(0)
  last     DateTime? @db.Date

  user   User             @relation(fields: [userId], references: [id])
  course ChineseCourse    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  point  ChinesePublished @relation(fields: [pointId], references: [id])

  @@id([userId, courseId, pointId])
  @@index([userId, courseId, due])
  @@map("chinese_review_states")
}

model ChineseReviewLog {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  pointId   String
  quality   Int
  isNew     Boolean
  correct   Boolean
  createdAt DateTime @default(now())

  user   User             @relation(fields: [userId], references: [id])
  course ChineseCourse    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  point  ChinesePublished @relation(fields: [pointId], references: [id])

  @@index([userId, courseId, createdAt])
  @@map("chinese_review_logs")
}